# Local Compose only. Choose a local password before starting; never commit .env.
COMPOSE_DB_PASSWORD=forever-local-only
# Set a private random value of at least 32 bytes; never reuse a production key.
JWT_SECRET=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=forever_owner
DB_PASSWORD=forever-local-only
DB_NAME=forever
DB_SSL=false
DB_SYNCHRONIZE=false
