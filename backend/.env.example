# Copy this file to .env and replace each placeholder with values for your LOCAL database.
# Never put a real password in this example file or commit your .env file.
DB_HOST=your-local-postgres-host
DB_PORT=5432
DB_USERNAME=your-local-postgres-user
DB_PASSWORD=your-local-postgres-password
DB_NAME=your-local-postgres-database

# Optional: NestJS listens on port 3000 when PORT is not set.
PORT=3000
