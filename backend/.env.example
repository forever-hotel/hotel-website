# Copy this file to .env and replace each placeholder with values for YOUR development database.
# Never put a real password in this example file or commit your .env file.

# --- Application ---
# Service name used in logs and the migrations table (<name>_migrations). Lowercase kebab-case.
# Each subsystem sets its own, e.g. hotel-website, front-desk, kitchen, worker-management.
SERVICE_NAME=hotel-website
# development | test | production (default: development)
NODE_ENV=development
# NestJS listens on port 3000 when PORT is not set.
PORT=3000
# text (readable, for local work) | json (structured logs for staging/production)
LOG_FORMAT=text

# --- Database (PostgreSQL) ---
# Neon: open your dev branch > Connect, turn OFF "Connection pooling",
# then copy host / database / role / password from the connection string.
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USERNAME=your-postgres-user
DB_PASSWORD=your-postgres-password
DB_NAME=your-postgres-database
# true for cloud databases such as Neon (TLS required); false for a local PostgreSQL.
DB_SSL=false
# true lets TypeORM change tables automatically. ONLY on a disposable dev database;
# it is rejected when NODE_ENV=production. Use migrations for shared data.
DB_SYNCHRONIZE=false
# true prints every SQL query (noisy; for debugging only).
DB_LOGGING=false
