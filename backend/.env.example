# Copy this file to .env and replace each placeholder with values for YOUR development database.
# Never put a real password in this example file or commit your .env file.

# --- Application ---
# --- Contact enquiry delivery (off by default) ---
# off | sandbox (validates without sending) | send (real delivery)
CONTACT_EMAIL_MODE=off
BREVO_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=

# Service name used in logs and the /health response. Lowercase kebab-case.
# Each subsystem sets its own, e.g. hotel-website, front-desk, kitchen, worker-management.
SERVICE_NAME=hotel-website
# development | test | production (default: development)
NODE_ENV=development
# NestJS listens on port 3000 when PORT is not set.
PORT=3000
# text (readable, for local work) | json (structured logs for staging/production)
LOG_FORMAT=text
# verbose | debug | log | warn | error. Shows that level and everything more serious.
# Default: debug in development, warn in test and production. Use log on staging.
LOG_LEVEL=debug

# --- Guest authentication ---
# Generate a unique random secret of at least 32 bytes for each environment.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ISSUER=hotel-website

# --- Database (PostgreSQL) ---
# Neon: open your dev branch > Connect, turn OFF "Connection pooling",
# then copy host / database / role / password from the connection string.
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USERNAME=your-postgres-user
DB_PASSWORD=your-postgres-password
DB_NAME=your-postgres-database
# true for cloud databases such as Neon (TLS required); false for a local PostgreSQL.
DB_SSL=false
# true lets TypeORM change tables automatically. ONLY on a disposable dev database;
# it is rejected when NODE_ENV=production. Keep false on the shared database: tables
# are created and changed only by forever-hotel/infra migrations.
DB_SYNCHRONIZE=false
# true prints every SQL query (noisy; for debugging only).
DB_LOGGING=false

# Booking confirmation email (#179). No email is sent by default.
# Use sandbox outside production; send is permitted only in production.
BOOKING_EMAIL_MODE=off
BREVO_API_KEY=
# Optional override; otherwise the existing CONTACT_EMAIL_FROM sender is used.
BOOKING_EMAIL_FROM=

# Booking modification/cancellation policy (DDP-#28).
# Development/test defaults: provisional 14:00 Sri Lanka check-in, strict >24h cutoff,
# full cancellation refund for staff processing, staff review of price differences.
# Production requires explicit hotel-confirmed policy; blank disables management there.
# Example only: confirm check-in time with the hotel before enabling production.
# BOOKING_MANAGEMENT_POLICY={"version":"hotel-policy-v1","checkInTime":"14:00","modificationSettlement":"MANUAL_REVIEW","cancellationRefund":"FULL_MANUAL_REVIEW"}
BOOKING_MANAGEMENT_POLICY=

# PayHere hosted checkout. Default off; use sandbox for development.
PAYHERE_MODE=off
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Retrieval API credentials, separate from the checkout merchant secret.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
# Public HTTPS gateway URL. Localhost cannot receive PayHere callbacks.
PAYHERE_NOTIFY_URL=https://your-public-gateway.example/hw/payments/payhere/notify
PAYMENT_RETURN_ORIGIN=http://localhost:3001
