# Optional server-side API Gateway origin. Never point this at a subsystem backend.
API_GATEWAY_URL=http://localhost:8080
# Server-only public website origin used by the contact form behind a reverse proxy.
# Hosted example: https://forever-hotel-staging.malaysiawest.cloudapp.azure.com
APP_ORIGIN=http://localhost:3001
# Comma-separated approved public HTTPS image hostnames (no scheme or path).
# Configure your chosen storage host and restart/rebuild after changing it.
ROOM_IMAGE_HOSTS=
